{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/main/crates/tauri-config-schema/schema.json",
  "productName": "Neural Compute Platform",
  "version": "2.4.0",
  "identifier": "com.nca.neuralcomputeplatform",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Neural Computing Architecture — Edge AI Platform",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Development",
    "shortDescription": "Neural Computing Architecture for High Performance and Energy Efficient AI Computation",
    "longDescription": "A Linux desktop application and AI runtime operating heterogeneous AI applications (Object Detection, Tiny LLM) across Milk-V Mars RISC-V host and FPGA Neural Compute Engine.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libappindicator3-1",
          "librsvg2-common",
          "python3 (>= 3.10)"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
